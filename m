 1 file changed, 47 insertions(+)
 create mode 100644 include/qemu/sizes.h

diff --git a/include/qemu/sizes.h b/include/qemu/sizes.h
new file mode 100644
index 0000000000..9aedb9f8f6
--- /dev/null
+++ b/include/qemu/sizes.h
