     uint8_t *smbios_tables, *smbios_anchor;
     size_t smbios_tables_len, smbios_anchor_len;
@@ -905,7 +905,7 @@ static void pc_build_smbios(PCMachineState *pcms)
=20
     smbios_tables =3D smbios_get_table_legacy(ms, &smbios_tables_len);
