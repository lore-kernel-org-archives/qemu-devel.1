@@ -0,0 +1,24 @@
+# To specify cross compiler prefix, use CROSS_PREFIX=3D
+#   $ make CROSS_PREFIX=3Ds390x-linux-gnu-
+
+.PHONY: all clean
+all: a-b-bios.h
+fwdir=3D../../../pc-bios/s390-ccw
+
+CFLAGS+=3D-ffreestanding -fno-delete-null-pointer-checks -fPIE -Os \
+	-msoft-float -march=3Dz900 -fno-asynchronous-unwind-tables -Wl,-pie \
+	-Wl,--build-id=3Dnone -nostdlib
+
+a-b-bios.h: s390x.elf
+	echo "$$__note" > header.tmp
+	xxd -i $< | sed -e 's/.*int.*//' >> header.tmp
+	mv header.tmp $@
+
+# We use common-page-size=3D16 to avoid big padding in the ELF file
+s390x.elf: a-b-bios.c
+	$(CROSS_PREFIX)gcc $(CFLAGS) -I$(fwdir) $(fwdir)/start.S \
+		$(fwdir)/sclp.c -Wl,-zcommon-page-size=3D16 -o $@ $<
+	$(CROSS_PREFIX)strip $@
+
+clean:
+	@rm -rf *.elf *.o
