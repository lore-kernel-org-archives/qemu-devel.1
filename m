> +	$(CROSS_PREFIX)gcc $(CFLAGS) -I$(fwdir) $(fwdir)/start.S \
> +		$(fwdir)/sclp.c -Wl,-zcommon-page-size=16 -o $@ $<
> +	$(CROSS_PREFIX)strip $@
> +
> +clean:
> +	@rm -rf *.elf *.o
